        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>com.imperium</groupId>
    <artifactId>distributed-lite-scheduler-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Distributed Lite Scheduler (Parent)</name>
